---
import { mailto } from '../data/site.js';
import { t as dict, localePath, otherLang, LOCALES } from '../i18n/index.js';
const { lang = 'pt', path = '/' } = Astro.props;
const t = dict(lang);
const isEvents = path.startsWith('/events');
const dpHref = `${localePath(lang, isEvents ? '/events' : '/')}#design-partners`;
---
<header class="site-header" id="site-header">
  <div class="container nav">
    <a class="nav__logo" href={localePath(lang, '/')} aria-label={t.nav.home}>
      <img class="nav__logo-lockup" src="/brand/sollelio-logo-horizontal-outlined.svg" alt="Sollelio" width="430" height="112" />
      <img class="nav__logo-symbol" src="/brand/sollelio-symbol-color.svg" alt="Sollelio" width="100" height="100" />
    </a>
    <div class="nav__right">
      <nav class="lang" aria-label={t.nav.lang}>
        {LOCALES.map((l) => (
          <a class="lang__link" href={localePath(l, path)} hreflang={dict(l).htmlLang} lang={dict(l).htmlLang} aria-current={l === lang ? 'true' : undefined} aria-label={dict(l).langName}>{dict(l).label}</a>
        ))}
      </nav>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-panel">
        <span class="nav__toggle-label">{t.nav.menu}</span>
        <span class="nav__toggle-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
      <nav class="nav__panel" id="nav-panel" aria-label={t.nav.primary}>
        <ul class="nav__list">
          <li><a class="nav__link" href={localePath(lang, '/events')} aria-current={isEvents ? 'page' : undefined}>{t.nav.events}</a></li>
          <li><a class="nav__link" href={dpHref}>{t.nav.partners}</a></li>
          <li><a class="btn btn--small nav__cta" href={mailto()}>{t.nav.contact}</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-offwhite) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line-2);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0; /* clear space ≥ ¼ symbol width */
  }
  .nav__logo-lockup {
    height: 2.375rem; /* ≈146px wide: above the 140px symbol-only threshold */
    width: auto;
  }
  .nav__logo-symbol {
    display: none;
    height: 2rem;
    width: 2rem;
  }
  .nav__right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav__link {
    font-weight: 500;
    font-size: var(--fs-small);
    color: var(--ink-2);
    padding: 0.5rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--ink);
  }
  .nav__link[aria-current='page'] {
    border-bottom-color: var(--ink);
  }

  /* Language switcher: two text options, no flags. */
  .lang {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px;
  }
  .lang__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.4rem;
    min-height: 2rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .lang__link:hover {
    color: var(--ink);
  }
  .lang__link[aria-current='true'] {
    background: var(--c-graphite);
    color: var(--c-offwhite);
  }

  .nav__toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .nav__toggle-icon {
    width: 1.25rem;
    display: grid;
    gap: 5px;
  }
  .nav__toggle-icon i {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease);
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-icon i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-icon i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 47.99em) {
    .nav__right {
      gap: 1rem;
    }
    .nav__toggle {
      display: inline-flex;
    }
    .nav__panel {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--c-offwhite);
      border-bottom: 1px solid var(--line-2);
      padding: 0.5rem var(--gutter) 1.25rem;
    }
    .nav__panel.is-open {
      display: block;
    }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav__link {
      display: block;
      padding: 0.9rem 0;
      font-size: 1.0625rem;
      border-bottom: 1px solid var(--line-2);
    }
    .nav__link[aria-current='page'] {
      border-bottom-color: var(--line-2);
      font-weight: 600;
    }
    .nav__cta {
      margin-top: 1rem;
      width: 100%;
      --h: 3rem;
    }
  }
  @media (max-width: 26em) {
    .nav__logo-lockup {
      display: none;
    }
    .nav__logo-symbol {
      display: block;
    }
  }
</style>
