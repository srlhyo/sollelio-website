---
// Product surface for Sollelio Events. Until real product UI is captured, it
// shows a schematic of the operational areas being investigated — clearly
// labelled as such. Pass `image` ({ src, alt, width, height }) to replace the
// schematic with a real screenshot without touching the surrounding section.
const { image, t } = Astro.props; // t = dict.product
const areas = t.areas.map((a) => a[0]);
---
<div class="ps theme-dark theme-events">
  <div class="ps__bar">
    <img class="ps__avatar" src="/brand/sollelio-events-avatar.svg" alt="" width="256" height="256" aria-hidden="true" />
    <span class="ps__name">{t.name}</span>
    <span class="ps__meta mono">{image ? t.metaImage : t.meta}</span>
  </div>

  {image ? (
    <img class="ps__shot" src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" />
  ) : (
    <div class="ps__map">
      <div class="ps__ends mono" aria-hidden="true">
        <span>{t.ends[0]}</span>
        <span>{t.ends[1]}</span>
      </div>
      <ol class="ps__rail" aria-label={t.railLabel}>
        {areas.map((a, i) => (
          <li class="ps__node reveal" style={`--d:${0.08 + i * 0.06}s`}>
            <span class="ps__dot" aria-hidden="true"></span>
            <span class="ps__label">{a}</span>
          </li>
        ))}
      </ol>
    </div>
  )}

  <dl class="ps__facts">
    {t.facts.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
  </dl>

  {!image && (
    <p class="ps__note micro">{t.note}</p>
  )}
</div>

<style>
  .ps {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-l);
    padding: 1.25rem 1.5rem 1.5rem;
    color: var(--ink);
    display: grid;
    gap: 1.5rem;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
  }
  .ps__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-2);
  }
  .ps__avatar {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
  }
  .ps__name {
    font-weight: 600;
    font-size: var(--fs-small);
  }
  .ps__meta {
    margin-left: auto;
    font-size: var(--fs-micro);
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }
  .ps__shot {
    width: 100%;
    height: auto;
    border-radius: var(--r-m);
    border: 1px solid var(--line-2);
  }
  .ps__map {
    display: grid;
    gap: 1rem;
    padding: 0.5rem 0 0.25rem;
  }
  .ps__ends {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-micro);
    color: var(--accent-ink);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ps__ends span:last-child {
    text-align: right;
  }
  .ps__rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    row-gap: 1.5rem;
  }
  .ps__node {
    position: relative;
    display: grid;
    gap: 0.85rem;
    justify-items: start;
    padding: 0 1rem 0 0;
    border-top: 1px solid var(--line);
  }
  .ps__dot {
    width: 11px;
    height: 11px;
    margin-top: -6px;
    border-radius: 3px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--surface);
  }
  .ps__node:first-child .ps__dot,
  .ps__node:last-child .ps__dot {
    background: var(--c-offwhite);
  }
  .ps__label {
    font-size: var(--fs-micro);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-2);
    text-wrap: balance;
  }
  .ps__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-2);
  }
  .ps__facts dt {
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.3rem;
  }
  .ps__facts dd {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .ps__note {
    color: var(--ink-3);
  }
  @media (max-width: 56em) {
    .ps__ends {
      display: none;
    }
    .ps__rail {
      grid-template-columns: 1fr;
      row-gap: 0;
      border-left: 1px solid var(--line);
      padding-left: 1.25rem;
    }
    .ps__node {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0.45rem 0;
      border-top: 0;
    }
    .ps__dot {
      position: absolute;
      left: calc(-1.25rem - 6px);
      top: 0.75rem;
      margin: 0;
    }
    .ps__label {
      font-size: var(--fs-small);
    }
  }
  @media (max-width: 40em) {
    .ps {
      padding: 1rem 1.1rem 1.25rem;
    }
    .ps__facts {
      grid-template-columns: 1fr;
    }
    .ps__meta {
      display: none;
    }
  }
</style>
