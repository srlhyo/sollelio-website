---
// Homepage hero figure: five fragments of an operation settle into one structure.
// Purely structural (no fake UI): labelled rows inside one frame. Motion is a
// one-off settle on load; reduced-motion users see the settled state.
const { t } = Astro.props; // t = dict.fig.hero
const geometry = [
  { w: 58, jx: -18, jy: -8, jr: -2.6 },
  { w: 74, jx: 14, jy: 6, jr: 1.8, accent: true },
  { w: 46, jx: -10, jy: 10, jr: 2.2 },
  { w: 66, jx: 20, jy: -6, jr: -1.4 },
  { w: 38, jx: -16, jy: 12, jr: 2.8 },
];
const rows = geometry.map((g, i) => ({ ...g, label: t.rows[i] }));
---
<figure class="hf" aria-labelledby="hf-cap">
  <div class="hf__frame">
    <div class="hf__top">
      <span class="hf__tag mono">{t.tag}</span>
      <span class="hf__planes" aria-hidden="true"><i></i><i></i></span>
    </div>
    <ol class="hf__rows">
      {rows.map((r, i) => (
        <li class:list={['hf__row', { 'hf__row--accent': r.accent }]} style={`--i:${i};--w:${r.w}%;--jx:${r.jx}px;--jy:${r.jy}px;--jr:${r.jr}deg`}>
          <span class="hf__label mono">{r.label}</span>
          <span class="hf__bar"><i></i></span>
          <span class="hf__dot" aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
  <figcaption id="hf-cap" class="hf__cap mono">{t.caption}</figcaption>
</figure>

<style>
  .hf {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .hf__frame {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--r-l);
    padding: 1.25rem 1.5rem 1.5rem;
    box-shadow:
      0 1px 0 rgba(37, 39, 43, 0.03),
      0 24px 60px -32px rgba(17, 21, 45, 0.28);
    position: relative;
    overflow: hidden;
  }
  /* Hairline grid: the structure the fragments settle into. */
  .hf__frame::before {
    content: '';
    position: absolute;
    inset: 3.6rem 1.5rem 1.5rem;
    background-image: linear-gradient(to right, var(--line-2) 1px, transparent 1px);
    background-size: 25% 100%;
    pointer-events: none;
  }
  .hf__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-2);
    margin-bottom: 1.1rem;
  }
  .hf__tag {
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .hf__planes {
    display: inline-flex;
    gap: 4px;
  }
  .hf__planes i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--c-indigo);
  }
  .hf__planes i:last-child {
    background: var(--c-cobalt);
  }
  .hf__rows {
    display: grid;
    grid-template-columns: max-content 1fr auto;
    column-gap: 1rem;
    row-gap: 0.9rem;
    position: relative;
  }
  .hf__row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
  }
  .hf__label {
    font-size: var(--fs-micro);
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hf__bar {
    height: 12px;
    border-radius: 6px;
    background: var(--bg-2);
    overflow: hidden;
  }
  .hf__bar i {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: inherit;
    background: var(--c-indigo);
    opacity: 0.85;
  }
  .hf__row--accent .hf__bar i {
    background: var(--c-cobalt);
    opacity: 1;
  }
  .hf__dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    border: 1.5px solid var(--ink-3);
    opacity: 0.6;
  }
  .hf__cap {
    font-size: var(--fs-micro);
    color: var(--ink-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Settle: rows start displaced and rotated, then land on the grid. */
  .js .hf__row {
    transform: translate(var(--jx), var(--jy)) rotate(var(--jr));
    opacity: 0.55;
    transition:
      transform 1.1s var(--ease),
      opacity 0.9s var(--ease);
    transition-delay: calc(0.15s + var(--i) * 0.1s);
  }
  .js .hf__bar i {
    transform: scaleX(0.45);
    transform-origin: left;
    transition: transform 1s var(--ease);
    transition-delay: calc(0.45s + var(--i) * 0.1s);
  }
  .js.is-ready .hf__row {
    transform: none;
    opacity: 1;
  }
  .js.is-ready .hf__bar i {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .hf__row,
    .js .hf__bar i {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }
  @media (max-width: 30em) {
    .hf__frame {
      padding: 1rem 1.1rem 1.25rem;
    }
    .hf__rows {
      column-gap: 0.75rem;
    }
    .hf__frame::before {
      inset: 3.3rem 1.1rem 1.25rem;
    }
  }
</style>
